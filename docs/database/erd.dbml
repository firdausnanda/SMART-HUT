Ref: kups.cdk_id > cdks.id [delete: set null, update: no action]
Ref: m_districts.regency_id > m_regencies.id [delete: no action, update: no action]
Ref: m_regencies.province_id > m_provinces.id [delete: no action, update: no action]
Ref: m_villages.district_id > m_districts.id [delete: no action, update: no action]
Ref: model_has_permissions.permission_id > permissions.id [delete: cascade, update: no action]
Ref: model_has_roles.role_id > roles.id [delete: cascade, update: no action]
Ref: nilai_ekonomi.cdk_id > cdks.id [delete: set null, update: no action]
