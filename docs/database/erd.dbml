// Struktur fisik database SMART-HUT; dibuat dengan php scripts/export-dbml.php.
// Relasi Ref berasal dari foreign key MySQL. Relasi Eloquent tanpa constraint tidak otomatis muncul.

Project SMART_HUT {
  database_type: 'MySQL'
  Note: 'Skema aktual database; kelompok tabel menunjukkan domain pemilik.'
}

// Master
Table m_provinces {
  id char(2) [pk]
  name varchar(255) [not null]
}

Table m_regencies {
  id char(4) [pk]
  province_id char(2) [not null]
  name varchar(255) [not null]
}

Table m_districts {
  id char(7) [pk]
  regency_id char(4) [not null]
  name varchar(255) [not null]
}

Table m_villages {
  id char(10) [pk]
  district_id char(7) [not null]
  name varchar(255) [not null]
}

Table m_bangunan_kta {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  description varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table m_sumber_dana {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_commodities {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  is_nilai_transaksi_ekonomi tinyint(1) [not null, default: 0]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table m_bukan_kayu {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_kayu {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_jenis_produksi {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_pengelola_wisata {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_pengelola_hutan {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_pengelola_ps {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

Table m_skema_perhutanan_sosial {
  id "bigint unsigned" [pk, increment]
  name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
}

// Rhl
Table rehab_lahan {
  id "bigint unsigned" [pk, increment]
  year year [not null]
  month tinyint [not null]
  province_id "bigint unsigned"
  regency_id char(4)
  district_id char(7)
  village_id char(10)
  target_annual decimal(15,2) [not null, default: 0.00]
  realization decimal(15,2) [not null, default: 0.00]
  fund_source varchar(255) [not null]
  coordinates varchar(255)
  status varchar(255) [not null, default: 'draft']
  approved_by_kasi_at timestamp
  approved_by_cdk_at timestamp
  rejection_note text
  created_by "bigint unsigned"
  updated_by "bigint unsigned"
  deleted_by "bigint unsigned"
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  cdk_id "bigint unsigned"
}

