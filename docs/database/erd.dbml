  province_id "bigint unsigned"
  regency_id char(4)
  district_id char(7)
  village_id char(10)
  target_annual decimal(15,2) [not null, default: 0.00]
  fund_source varchar(255) [not null]
  status varchar(255) [not null, default: 'draft']
  approved_by_kasi_at timestamp
  approved_by_cdk_at timestamp
  rejection_note text
  created_by "bigint unsigned"
  updated_by "bigint unsigned"
  deleted_by "bigint unsigned"
  created_at timestamp
