}

// BinaUsaha
Table hasil_hutan_kayu {
  id "bigint unsigned" [pk, increment]
  year year [not null]
  month tinyint [not null]
  province_id "bigint unsigned" [not null]
  regency_id "bigint unsigned" [not null]
  district_id "bigint unsigned"
  pengelola_hutan_id "bigint unsigned"
  pengelola_wisata_id "bigint unsigned"
  forest_type "enum('Hutan Negara','Hutan Rakyat','Perhutanan Sosial')" [not null]
  volume_target decimal(15,2) [not null, default: 0.00]
  status varchar(255) [not null, default: 'draft']
  approved_by_kasi_at timestamp
  approved_by_cdk_at timestamp
  rejection_note text
  created_by "bigint unsigned"
  updated_by "bigint unsigned"
  deleted_by "bigint unsigned"
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  cdk_id "bigint unsigned"
}

Table hasil_hutan_kayu_details {
  id "bigint unsigned" [pk, increment]
  hasil_hutan_kayu_id "bigint unsigned" [not null]
  kayu_id "bigint unsigned" [not null]
  volume_realization decimal(15,2) [not null, default: 0.00]
  created_at timestamp
  updated_at timestamp
}

Table hasil_hutan_bukan_kayu {
  id "bigint unsigned" [pk, increment]
