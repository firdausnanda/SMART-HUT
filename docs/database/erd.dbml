Ref: nilai_ekonomi_details.nilai_ekonomi_id > nilai_ekonomi.id [delete: cascade, update: no action]
Ref: nilai_transaksi_ekonomi.cdk_id > cdks.id [delete: set null, update: no action]
Ref: nilai_transaksi_ekonomi_details.commodity_id > m_commodities.id [delete: no action, update: no action]
Ref: nilai_transaksi_ekonomi_details.nilai_transaksi_ekonomi_id > nilai_transaksi_ekonomi.id [delete: cascade, update: no action]
Ref: pbphh.cdk_id > cdks.id [delete: set null, update: no action]
Ref: pbphh_jenis_produksi.jenis_produksi_id > m_jenis_produksi.id [delete: cascade, update: no action]
Ref: pbphh_jenis_produksi.pbphh_id > pbphh.id [delete: cascade, update: no action]
Ref: pegawais.bezetting_id > bezettings.id [delete: set null, update: no action]
Ref: pegawais.cdk_id > cdks.id [delete: set null, update: no action]
Ref: penghijauan_lingkungan.cdk_id > cdks.id [delete: set null, update: no action]
Ref: pengunjung_wisata.cdk_id > cdks.id [delete: set null, update: no action]
Ref: perkembangan_kth.cdk_id > cdks.id [delete: set null, update: no action]
Ref: realisasi_pnbp.cdk_id > cdks.id [delete: set null, update: no action]
Ref: reboisasi_ps.cdk_id > cdks.id [delete: set null, update: no action]
Ref: reboisasi_ps.pengelola_id > m_pengelola_ps.id [delete: set null, update: no action]
Ref: rehab_lahan.cdk_id > cdks.id [delete: set null, update: no action]
Ref: rehab_manggrove.cdk_id > cdks.id [delete: set null, update: no action]
