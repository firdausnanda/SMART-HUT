}

Table pengunjung_wisata {
  id "bigint unsigned" [pk, increment]
  year year [not null]
  month tinyint [not null]
  id_pengelola_wisata varchar(255) [not null]
  number_of_visitors varchar(255) [not null]
  gross_income varchar(255) [not null]
  status varchar(255) [not null, default: 'draft']
  approved_by_kasi_at timestamp
  approved_by_cdk_at timestamp
  rejection_note text
